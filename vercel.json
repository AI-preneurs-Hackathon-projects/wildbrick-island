{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "vercel-public",
  "framework": null,
  "regions": [
    "hnd1"
  ],
  "functions": {
    "api/handler.js": {
      "maxDuration": 120
    },
    "api/arena-realtime.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/arena/realtime",
      "destination": "/api/arena-realtime"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/handler?route=:path*"
    }
  ]
}
