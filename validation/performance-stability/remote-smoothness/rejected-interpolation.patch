+// Presentation only: one bounded transition between known remote transforms.
+// No extrapolation, snapshot buffering or server-clock estimation. A room update
+// is not actor motion: accepted frame progress and pose identify fresh samples.
+const LIMIT_MS=220,angle=a=>Math.atan2(Math.sin(a),Math.cos(a));
+const pose=p=>({x:p.x,y:p.y,z:p.z,yaw:p.yaw});
+const distance=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y,a.z-b.z);
+export function createRemoteMotionView(){
