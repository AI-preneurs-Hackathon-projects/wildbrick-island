+ function update(p,snapshot,now){
+  clock=Math.max(clock,Number.isFinite(now)?now:clock);
+  const identity=JSON.stringify([snapshot.epoch,snapshot.round?.id,snapshot.round?.mapId,snapshot.round?.status,p.id,p.spawnSerial||0,p.health>0,p.kit.id]);
+  const next=pose(p),nextFrame=Number.isSafeInteger(p.motion?.frame)?p.motion.frame:null,time=p.motion?.at??snapshot.time??0;
+  function reset(){key=identity;from=target=shown=next;start=lastReceipt=clock;duration=0;frame=nextFrame??-1;sourceTime=time;}
+  if(!target||identity!==key){reset();return {...shown};}
+  // The real client rejects old snapshots; keep this visual boundary defensive.
+  if((nextFrame!==null&&nextFrame<frame)||time<sourceTime)return sample();
+  const changed=distance(next,target)>1e-8||Math.abs(angle(next.yaw-target.yaw))>1e-8;
+  const fresh=nextFrame!==null?nextFrame>frame:time>sourceTime;
+  if(changed||fresh){
+   const interval=clock-lastReceipt;
+   const teleport=distance(next,target)>Math.max(6,(p.kit.stats.speed||0)*Math.min(interval,1000)/1000*2+2);
+   if(teleport){reset();return {...shown};}
+   // Repeated unchanged poses never restart an unfinished transition.
+   // Preserve the observed transition duration across short receipt bursts;
+   // a late sample followed closely by another must not accelerate catch-up.
+   if(changed){from=sample();target=next;start=clock;duration=Math.min(LIMIT_MS,Math.max(80,interval,duration));}
+   lastReceipt=clock;frame=nextFrame??frame;sourceTime=time;
+  }
+  return sample();
+ }
+ function sample(){const t=duration?Math.min(1,Math.max(0,(clock-start)/duration)):1;shown={x:from.x+(target.x-from.x)*t,y:from.y+(target.y-from.y)*t,z:from.z+(target.z-from.z)*t,yaw:from.yaw+angle(target.yaw-from.yaw)*t};return {...shown};}
+ function clear(){key=null;from=target=shown=null;frame=-1;sourceTime=-Infinity;clock=start=duration=lastReceipt=0;}
+ return {update,clear};
